# Configuration du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URLs des applications
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/...
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/...

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=contact@weareclimbers.fr
NEXT_PUBLIC_SUPPORT_EMAIL=support@weareclimbers.fr

# Réseaux sociaux
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/weareclimbers
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/weareclimbers

# ========================================================
# Configuration SMTP OVH pour le formulaire de contact
# ========================================================
# Documentation OVH SMTP: https://docs.ovh.com/fr/emails/generalites-sur-les-emails-mutualises/

# Serveur SMTP OVH (généralement ssl0.ovh.net ou pro1.mail.ovh.net)
SMTP_HOST=ssl0.ovh.net

# Port SMTP (465 pour SSL, 587 pour TLS)
SMTP_PORT=465

# Identifiant de connexion (généralement l'adresse email complète)
SMTP_USER=contact@weareclimbers.fr

# Mot de passe du compte email
SMTP_PASS=votre_mot_de_passe_ici

# Adresse email d'expédition (doit correspondre au compte SMTP)
SMTP_FROM=contact@weareclimbers.fr

# Adresse email de destination (où recevoir les messages du formulaire)
SMTP_TO=contact@weareclimbers.fr

# ========================================================
# Configuration Brevo (Newsletter - déjà en place)
# ========================================================

BREVO_API_KEY=your_brevo_api_key_here
BREVO_LIST_ID=your_brevo_list_id_here
# Liste « clients pré-commande » (webhook Stripe) — liste #13 en prod
BREVO_PREORDER_LIST_ID=13

# ========================================================
# Stripe — Checkout pré-commandes V2 (chantier 08/2026)
# ========================================================
# ⚠️ Compte Stripe PARTAGÉ avec le SaaS coach + flux bracelet (CF Firebase).
# Clé RESTREINTE dédiée website (Checkout Sessions write, Products/Prices read) —
# JAMAIS la sk complète des CF coach, jamais NEXT_PUBLIC_*, jamais commitée.
# Développer d'abord en mode TEST (rk_test_...).
STRIPE_SECRET_KEY=rk_test_...

# Secret de signature du webhook DÉDIÉ website (/api/stripe-webhook) —
# PAS celui des Cloud Functions coach.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price de la pré-commande (tax_behavior=inclusive obligatoire ; l'ID diffère test/live)
STRIPE_PRICE_PREORDER=price_...

# Shipping rates par zone/mode (tax_code txcd_92010001 ; les IDs diffèrent test/live)
STRIPE_SHIPPING_RATE_FR=shr_...
STRIPE_SHIPPING_RATE_FR_DOMICILE=shr_...
STRIPE_SHIPPING_RATE_BE_LU=shr_...
STRIPE_SHIPPING_RATE_CH=shr_...
STRIPE_SHIPPING_RATE_DOM_TOM=shr_...

# Destinataire des notifications de pré-commande (fallback : julien@weareclimbers.fr)
# PREORDER_NOTIFY_TO=julien@weareclimbers.fr

# ========================================================
# Mondial Relay — recherche de points relais + expéditions
# ========================================================
# Codes API du compte pro (Espace Pro MR). La clé privée reste côté serveur,
# jamais en NEXT_PUBLIC_*. Recherche de relais = lecture seule ; la création
# d'expéditions se fait via le script d'expédition dédié (novembre).
# Sandbox MR (dev) : Enseigne TTMRSDBX / clé 9ytnxVCC / Code Marque TT (99).
# En PROD : les codes réels du compte WeAreClimbers.
MONDIAL_RELAY_ENSEIGNE=TTMRSDBX
MONDIAL_RELAY_PRIVATE_KEY=...
# Optionnel — endpoint API (défaut : https://api.mondialrelay.com/Web_Services.asmx)
# MONDIAL_RELAY_API_URL=https://api.mondialrelay.com/WebService.asmx

# ========================================================
# Configuration Umami Analytics
# ========================================================
# Après avoir déployé Umami sur Vercel, remplis ces variables :
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_SRC=https://your-umami-instance.vercel.app/script.js
