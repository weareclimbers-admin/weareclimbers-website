# Configuration du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URLs des applications
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/...
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/...

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=contact@weareclimbers.fr
NEXT_PUBLIC_SUPPORT_EMAIL=support@weareclimbers.fr

# Réseaux sociaux
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/weareclimbers
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/weareclimbers

# ========================================================
# Configuration SMTP OVH pour le formulaire de contact
# ========================================================
# Documentation OVH SMTP: https://docs.ovh.com/fr/emails/generalites-sur-les-emails-mutualises/

# Serveur SMTP OVH (généralement ssl0.ovh.net ou pro1.mail.ovh.net)
SMTP_HOST=ssl0.ovh.net

# Port SMTP (465 pour SSL, 587 pour TLS)
SMTP_PORT=465

# Identifiant de connexion (généralement l'adresse email complète)
SMTP_USER=contact@weareclimbers.fr

# Mot de passe du compte email
SMTP_PASS=votre_mot_de_passe_ici

# Adresse email d'expédition (doit correspondre au compte SMTP)
SMTP_FROM=contact@weareclimbers.fr

# Adresse email de destination (où recevoir les messages du formulaire)
SMTP_TO=contact@weareclimbers.fr

# ========================================================
# Configuration Brevo (Newsletter - déjà en place)
# ========================================================

BREVO_API_KEY=your_brevo_api_key_here
BREVO_LIST_ID=your_brevo_list_id_here

# ========================================================
# Configuration Umami Analytics
# ========================================================
# Après avoir déployé Umami sur Vercel, remplis ces variables :
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_SRC=https://your-umami-instance.vercel.app/script.js
